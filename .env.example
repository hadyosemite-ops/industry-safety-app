# ============================================================
# Variables d'environnement — Industry Safety App
# Copier ce fichier en .env.local et renseigner les valeurs
# ============================================================

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App
VITE_APP_NAME="Industry Safety App"
VITE_APP_ENV=development

# Assistant HSE (api/claude.ts) — clé secrète SERVEUR uniquement.
# ⚠️ Ne JAMAIS préfixer cette variable par VITE_ : Vite inline dans le bundle
# client toute variable préfixée VITE_, ce qui exposerait la clé au navigateur.
# À définir dans Vercel → Project Settings → Environment Variables (pas ici en prod).
ANTHROPIC_API_KEY=your-anthropic-api-key-here
